# ==============================================================================
# КОНФИГУРАЦИЯ СЕРВЕРА ДЛЯ ПРОДАКШЕНА (HTTPS / SUBDOMAIN)
# ==============================================================================

# База данных PostgreSQL
POSTGRES_DB=photogallery
POSTGRES_USER=photouser
POSTGRES_PASSWORD=generate_a_strong_password_here
DATABASE_URL=postgres://photouser:generate_a_strong_password_here@postgres:5432/photogallery?sslmode=disable

# Внутренний порт приложения для связи с внешним хостовым Nginx
# Привязка к 127.0.0.1 защищает контейнер от прямого доступа из интернета в обход SSL
APP_PORT=8080
APP_BIND_IP=127.0.0.1
PORT=8080

# Секретный ключ JWT (сгенерируйте случайную строку от 32 символов)
JWT_SECRET=generate_a_random_32_character_jwt_secret_key!

# Безопасность Cookies: на HTTPS строго TRUE (флаг Secure; HttpOnly; SameSite=Lax)
COOKIE_SECURE=true

# Данные начальной учётной записи администратора (создаётся при первом запуске)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=generate_a_secure_admin_password_here

# Лимиты загрузки и директория медиафайлов
UPLOAD_DIR=/uploads
MAX_UPLOAD_SIZE=20971520

# Физический путь к хранилищу фотографий на сервере (на отдельном диске / разделе)
# Например: /mnt/storage/photos или /data/gallery_uploads
PHOTOS_STORAGE_PATH=/mnt/storage/photos

# Разрешённый домен для CORS (ваш поддомен с https://)
CORS_ALLOWED_ORIGINS=https://photos.yourdomain.com
